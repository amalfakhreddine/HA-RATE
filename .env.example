# =================================================================
# HA-RATE PROTOCOL - ENVIRONMENT VARIABLES
# =================================================================
# Copy this file to .env and replace all placeholder values
# NEVER commit .env to version control - it contains secrets!
# =================================================================

# -----------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------
# Main wallet address for receiving USDT payments (public address, safe to share)
# Example format: UQCfgFwb0pSwSZxKb58vDyqZ7phHtyvuPr09Oe9pRVn3Azy3
VITE_MAIN_WALLET=your_main_wallet_address_here

# -----------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------
# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com/
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=your_mongodb_connection_string_here

# -----------------------------------------------------------------
# Session Security
# -----------------------------------------------------------------
# Secret key for encrypting session cookies (generate random 32+ char string)
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_session_secret_here

# -----------------------------------------------------------------
# Admin Authentication
# -----------------------------------------------------------------
# Admin username for login
ADMIN_USERNAME=your_admin_username_here

# Admin password hash (bcrypt with 12 rounds)
# Generate with: node -e "console.log(require('bcrypt').hashSync('YOUR_PASSWORD', 12))"
ADMIN_PASSWORD_HASH=your_bcrypt_password_hash_here

# -----------------------------------------------------------------
# TON Blockchain Configuration
# -----------------------------------------------------------------
# Network: "mainnet" or "testnet"
TON_NETWORK=mainnet

# Main wallet address (same as VITE_MAIN_WALLET but for backend)
# This is where users send USDT payments
MAIN_WALLET=your_main_wallet_address_here

# Admin wallet private key in HEX format (⚠️ CRITICAL SECRET - NEVER SHARE!)
# Used for: Sending withdrawal TON coins to users (for fees/refunds)
# Export from Tonkeeper: Settings → Wallet → Back Up → Convert seed to hex
TON_SENDER_PRIVATE_KEY=your_private_key_hex_here

# Project wallet for sending HA-RATE tokens (⚠️ CRITICAL SECRET - NEVER SHARE!)
# This wallet automatically sends HA-RATE tokens when users pay withdrawal fees
# Key: The private key in HEX format (export from Tonkeeper)
# Note: Wallet address is automatically derived from the private key
PROJECT_WALLET_KEY=your_project_wallet_private_key_hex_here

# TonCenter API key (optional, for higher rate limits)
# Get from: https://toncenter.com/api/v2/
TON_API_KEY=your_toncenter_api_key_here

# -----------------------------------------------------------------
# Withdrawal System Configuration
# -----------------------------------------------------------------
# Fee amount in TON that users pay for withdrawals
# Default: 0.50 TON
WITHDRAWAL_FEE_TON=0.50

# Enable withdrawals (set to 'true' after TGE is enabled)
# Default: false (withdrawals disabled until TGE)
WITHDRAWALS_ENABLED=false

# -----------------------------------------------------------------
# CORS Configuration (Production Only)
# -----------------------------------------------------------------
# Frontend domain for CORS (only needed if frontend is on different domain)
# Example: https://your-app.replit.app
# Leave commented out for development (localhost is allowed automatically)
# FRONTEND_ORIGIN=https://your-production-frontend-domain.com

# -----------------------------------------------------------------
# Deployment Detection (Auto-configured)
# -----------------------------------------------------------------
# These are automatically set by Replit, do NOT manually configure:
# NODE_ENV=production (auto-detected on Replit)
# REPL_ID=<replit_id> (auto-set by Replit)
